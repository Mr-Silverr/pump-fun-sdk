# ── Required ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Solana RPC (all optional: the defaults need no key and no account) ────────
# Primary endpoint. The default serves both HTTP and logsSubscribe for free.
# SOLANA_RPC_URL=https://rpc.magicblock.app/mainnet

# WebSocket endpoint. Derived from SOLANA_RPC_URL when unset.
# Polling mode samples only the 20 most recent signatures per program per tick,
# so on a busy chain it WILL miss claims. Keep the bot on WebSocket.
# SOLANA_WS_URL=wss://rpc.magicblock.app/mainnet

# Comma-separated extra endpoints for failover (rotates on 429/5xx/timeout).
# Defaults to mainnet-beta and publicnode when unset.
# SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com

# Polling interval in seconds (used only when WebSocket is unavailable)
# POLL_INTERVAL_SECONDS=15

# ── Dry run ───────────────────────────────────────────────────────────────────
# `npm run dryrun` monitors mainnet with no Telegram bot attached. Seconds to run:
# DRYRUN_SECONDS=120

# ── Misc ──────────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
# LOG_LEVEL=info

# Where the tracking store is persisted
# DATA_DIR=./data

# ── Durable state (required on Cloud Run, ignored elsewhere) ─────────────────
# A container filesystem is scratch space: without a mirror, a redeploy drops
# every tracked item, every chat setting, and the claim history. Set a Cloud
# Storage bucket and the bot restores state at boot and mirrors every write.
# The deploy script creates the bucket and grants the runtime account.
# STATE_BUCKET=pumpfun-bot-state
# STATE_PREFIX=claim-bot/

# ── Trading venue referral codes ─────────────────────────────────────────────
# Every claim alert links out to these terminals. Set a code to an empty string
# to drop that venue from the alerts.
# AXIOM_REF=nich
# GMGN_REF=nichxbt
# PADRE_REF=nichxbt
# FOMO_REF=nichxbt

# ── Twitter/X API (optional) ──────────────────────────────────────────────────
# Enables follower count & influencer tracking for X accounts
# Get your bearer token from https://developer.twitter.com/
# TWITTER_BEARER_TOKEN=your_bearer_token_here

# Comma-separated list of influential X account IDs to check for follows
# Example: 44196397 (Elon Musk), 783214 (Obama), etc.
# TWITTER_INFLUENCER_IDS=44196397,783214

# ── Relay mode (alternative to direct RPC) ────────────────────────────────────
# Consume parsed claims from the websocket-server relay instead of the chain.
# RELAY_WS_URL=ws://localhost:3099/ws
