# ── Telegram ──────────────────────────────────────────────────────────────────
# Its own bot from @BotFather. Do NOT reuse the first-claims bot token.
TELEGRAM_BOT_TOKEN=
# Channel to post to: @your_channel_name or the numeric -100... chat ID.
# The bot must be an administrator of the channel with permission to post.
CHANNEL_ID=

# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://rpc.magicblock.app/mainnet
# Strongly recommended. Without a WebSocket the bot polls, which samples only the
# 20 most recent signatures per program per tick and WILL miss claims.
SOLANA_WS_URL=wss://rpc.magicblock.app/mainnet
# Optional comma-separated fallback RPC endpoints.
SOLANA_RPC_URLS=
# Only used when no WebSocket is available.
POLL_INTERVAL_SECONDS=30

# ── Flood control ─────────────────────────────────────────────────────────────
# Claims worth this much USD or more post as their own message.
INSTANT_THRESHOLD_USD=100
# Claims below this are counted but not listed. 0 keeps everything.
MIN_CLAIM_USD=0
# How often the digest of sub-threshold claims posts.
DIGEST_INTERVAL_SECONDS=60
# Claims listed per digest; any beyond this are summarized as "+N more".
DIGEST_MAX_LINES=12
# Telegram accepts roughly 20 posts/min to a channel. Max 19.
MAX_POSTS_PER_MINUTE=15

# ── Feed contents ─────────────────────────────────────────────────────────────
# Cashback claims are user refunds rather than creator activity, and are the
# highest-volume claim type on chain.
INCLUDE_CASHBACK=false
# distribute_creator_fees payouts to fee shareholders.
INCLUDE_DISTRIBUTIONS=true

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=3000
