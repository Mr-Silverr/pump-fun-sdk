# Required
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
CHANNEL_ID=-1001234567890

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Comma-separated fallback RPCs (rotates on 429/5xx/timeout)
# SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com,https://your-second-rpc.com,https://your-third-rpc.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Affiliate ref codes for trading links
AXIOM_REF=nich
GMGN_REF=nichxbt
PADRE_REF=nichxbt

# Optional — enrichment APIs
GITHUB_TOKEN=ghp_your_github_pat
GROQ_API_KEY=gsk_your_groq_api_key
# Optional — X/Twitter follower counts & influencer detection
# Uses Twitter's internal GraphQL API (same as xactions). Get cookies from x.com DevTools > Application > Cookies
# X_AUTH_TOKEN=your_auth_token_cookie_from_xcom
# X_CT0_TOKEN=your_ct0_cookie_from_xcom

# Feed toggles (all default to true)
FEED_CLAIMS=true
FEED_LAUNCHES=true
FEED_GRADUATIONS=true
FEED_WHALES=true
FEED_FEE_DISTRIBUTIONS=true

# Tuning
POLL_INTERVAL_SECONDS=30
WHALE_THRESHOLD_SOL=10
LOG_LEVEL=info

# Health check server (Railway sets PORT automatically)
# The same port also serves the read-only JSON API:
#   GET /health  GET /stats  GET /events/recent?limit=50&kind=graduation  GET /events/stream (SSE)
# PORT=3000

# Admin commands over Telegram DM (/status, /feeds, /threshold, /mute, /recent).
# Comma-separated numeric Telegram user IDs; leave unset to disable entirely.
# Find your ID by messaging @userinfobot.
# ADMIN_USER_IDS=123456789

# Webhook fan-out: every detected event is POSTed as JSON to each URL.
# With WEBHOOK_SECRET set, deliveries carry X-PumpFeed-Signature-256 (HMAC-SHA256).
# WEBHOOK_URLS=https://example.com/pump-hook
# WEBHOOK_SECRET=change-me

# Call follow-ups: reply to each posted card when the token hits a multiple of
# its market cap at alert time, collapses, or the dev sells down their position.
PERFORMANCE_UPDATES=true
PERFORMANCE_WINDOW_HOURS=24
PERFORMANCE_MILESTONES=2,5,10,25,50,100
PERFORMANCE_COLLAPSE_PCT=80
